@{
    ViewData["Title"] = "Performance Analysis";
}

<div class="page-header sf-page-header">
    <h2>Performance Analysis <small>Parallel processing insights</small></h2>
    <p class="text-muted">Benchmark how parallel processing accelerates shrinkage computations.</p>
</div>

<p class="text-muted sf-analysis-intro">
    This page focuses on parallel processing performance using <strong>synthetic_large.csv</strong>.
    For fabric behavior analytics, open <a asp-controller="Analysis" asp-action="Index">Simulation Analysis</a>.
</p>

<p class="text-muted">
    Tip: hover any chart to see exact values. Legends are shown beneath the charts for readability.
</p>

<div class="panel panel-default sf-analysis-summary">
    <div class="panel-heading">Performance summary</div>
    <div class="panel-body">
        <div class="row">
            <div class="col-sm-4">
                <div class="sf-metric">
                    <div class="sf-metric-label">Speedup</div>
                    <div class="sf-metric-value" id="perfSpeedup">-</div>
                    <div class="sf-metric-sub">
                        single: <span id="perfSingle">-</span>s,
                        parallel: <span id="perfParallel">-</span>s
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="sf-metric">
                    <div class="sf-metric-label">Rows</div>
                    <div class="sf-metric-value" id="perfRows">-</div>
                    <div class="sf-metric-sub">
                        workers: <span id="perfWorkers">-</span>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="sf-metric">
                    <div class="sf-metric-label">Efficiency (peak)</div>
                    <div class="sf-metric-value" id="perfEfficiency">-</div>
                    <div class="sf-metric-sub">speedup / workers</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row sf-analysis-grid">
    <div class="col-md-6">
        <div class="panel panel-warning sf-analysis-panel">
            <div class="panel-heading">
                Speedup vs. number of workers
                <span class="sf-help" data-toggle="tooltip" data-placement="left" title="Observed speedup relative to a single worker. Linear scaling would be a straight line from the origin.">
                    <img src="~/img/help-icon.svg" alt="Help" class="sf-help-icon" />
                </span>
            </div>
            <div class="panel-body">
                <div class="sf-canvas-wrap">
                    <canvas id="perfSpeedupChart" height="220"></canvas>
                </div>
                <p class="help-block">Measured speedup as the number of workers increases.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-warning sf-analysis-panel">
            <div class="panel-heading">
                Efficiency vs. workers
                <span class="sf-help" data-toggle="tooltip" data-placement="left" title="Efficiency = speedup / number of workers. Values closer to 1 indicate better parallel utilization.">
                    <img src="~/img/help-icon.svg" alt="Help" class="sf-help-icon" />
                </span>
            </div>
            <div class="panel-body">
                <div class="sf-canvas-wrap">
                    <canvas id="perfEfficiencyChart" height="220"></canvas>
                </div>
                <p class="help-block">Efficiency is speedup divided by worker count.</p>
            </div>
        </div>
    </div>
</div>

<div class="row sf-analysis-grid">
    <div class="col-md-6">
        <div class="panel panel-warning sf-analysis-panel">
            <div class="panel-heading">
                Scaling time (seconds)
                <span class="sf-help" data-toggle="tooltip" data-placement="left" title="Absolute runtime for each worker count. Lower is better; compare with the speedup chart for context.">
                    <img src="~/img/help-icon.svg" alt="Help" class="sf-help-icon" />
                </span>
            </div>
            <div class="panel-body">
                <div class="sf-canvas-wrap">
                    <canvas id="perfScalingChart" height="220"></canvas>
                </div>
                <p class="help-block">Absolute runtime in seconds for each worker count.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-warning sf-analysis-panel">
            <div class="panel-heading">
                Parallel overhead estimate
                <span class="sf-help" data-toggle="tooltip" data-placement="left" title="Estimated overhead beyond ideal linear scaling (coordination, scheduling, IO). Lower is better.">
                    <img src="~/img/help-icon.svg" alt="Help" class="sf-help-icon" />
                </span>
            </div>
            <div class="panel-body">
                <div class="sf-canvas-wrap">
                    <canvas id="perfOverheadChart" height="220"></canvas>
                </div>
                <p class="help-block">Estimated overhead beyond ideal linear scaling.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.4.0/Chart.min.js"></script>
    <script src="~/js/performance.js"></script>
}