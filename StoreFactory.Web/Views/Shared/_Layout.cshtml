<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StoreFactory Web Simulator</title>

    <link rel="stylesheet" href="https://ajax.aspnetcdn.com/ajax/bootstrap/3.3.7/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @{
        var currentController = (ViewContext.RouteData.Values["controller"] as string ?? "").ToLowerInvariant();
        var currentAction = (ViewContext.RouteData.Values["action"] as string ?? "").ToLowerInvariant();
    }
    <nav class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="navbar-brand">StoreFactory</a>
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li class="@(currentController == "home" && currentAction == "index" ? "active" : "")"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="@(currentController == "simulator" ? "active" : "")"><a asp-area="" asp-controller="Simulator" asp-action="Index">Simulator</a></li>
                    <li class="@(currentController == "analysis" && currentAction == "index" ? "active" : "")"><a asp-area="" asp-controller="Analysis" asp-action="Index">Simulation Analysis</a></li>
                    <li class="@(currentController == "analysis" && currentAction == "performance" ? "active" : "")"><a asp-area="" asp-controller="Analysis" asp-action="Performance">Performance Analysis</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container-fluid body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; 2016 StoreFactory</p>
        </footer>
    </div>

    <script src="https://ajax.aspnetcdn.com/ajax/jquery/jquery-2.2.0.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/bootstrap/3.3.7/bootstrap.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
