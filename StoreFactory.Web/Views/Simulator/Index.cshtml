@model StoreFactory.Web.Models.SimulatorViewModel

@{
    ViewData["Title"] = "Simulator";
}

<div class="page-header sf-page-header">
    <h2>Simulator <small>Explore heat-setting parameters and shrinkage behavior</small></h2>
    <p class="text-muted">Adjust temperature and dwell time to see predicted fabric changes and smart-factory recommendations.</p>
</div>

<div class="row sf-main-row">
    <!-- Left: Process settings -->
    <div class="col-lg-3 col-md-4 col-sm-12">
        <div class="sf-section">
        <div class="sf-section-title">
            Inputs
        </div>
            <div class="panel panel-default sf-panel-compact">
                <div class="panel-body">
                    <form id="simulatorForm">
                        <div class="form-group">
                            <label>Material (measured dataset)</label>
                            <select asp-for="SelectedMaterialId" asp-items="Model.Materials" class="form-control"></select>
                        </div>

                        <div class="form-group">
                            <label>Temperature <span class="sf-unit">&deg;C</span></label>
                            <div class="sf-range-row">
                                <input asp-for="Temperature" type="range" min="30" max="200" step="1" class="form-control" />
                                <span id="tempValue" class="sf-range-value">@Model.Temperature</span>
                            </div>
                            <div class="sf-range-hint">Range 30&ndash;200 &deg;C (higher heat increases shrinkage risk).</div>
                        </div>

                        <div class="form-group">
                            <label>Dwell Time <span class="sf-unit">min</span></label>
                            <div class="sf-range-row">
                                <input asp-for="DwellTime" type="range" min="1" max="20" step="0.5" class="form-control" />
                                <span id="timeValue" class="sf-range-value">@Model.DwellTime</span>
                            </div>
                            <div class="sf-range-hint">Range 1&ndash;20 minutes (longer dwell increases shrinkage).</div>
                        </div>
                    </form>

                    <div class="sf-info-note">
                        <span class="sf-info-label">Tip</span>
                        <span><strong>1.00</strong> = no change, <strong>&lt; 1</strong> shrink, <strong>&gt; 1</strong> expansion.</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="sf-section">
        <div class="sf-section-title">
            Results
        </div>
            <div class="panel panel-info sf-panel-compact">
                <div class="panel-body" id="resultsPanel">
                    <div class="sf-result-row">
                        <div>
                            <div class="sf-result-label">Length factor</div>
                            <div class="sf-result-caption">Main shrinkage indicator</div>
                        </div>
                        <div id="resLength" class="sf-result-value text-success">-</div>
                    </div>
                    <div class="sf-result-row">
                        <div>
                            <div class="sf-result-label">Width factor</div>
                            <div class="sf-result-caption">Cross direction change</div>
                        </div>
                        <div id="resWidth" class="sf-result-value text-success">-</div>
                    </div>
                    <div class="sf-result-row">
                        <div>
                            <div class="sf-result-label">Sleeve factor</div>
                            <div class="sf-result-caption">Sleeve dimension change</div>
                        </div>
                        <div id="resSleeve" class="sf-result-value text-success">-</div>
                    </div>

                    <div class="sf-result-row">
                        <div>
                            <div class="sf-result-label">Confidence</div>
                            <div class="sf-result-caption">Based on distance to measured data points</div>
                        </div>
                        <div id="resConfidence" class="sf-result-value">-</div>
                    </div>
                    <div class="sf-result-row">
                        <div>
                            <div class="sf-result-label">Status</div>
                            <div class="sf-result-caption">Quality alert based on shrinkage thresholds</div>
                        </div>
                        <div id="resStatus" class="sf-result-value">Calculating...</div>
                    </div>
                    <!-- warningMsg and loadingOverlay are injected here by simulator.js -->
                </div>
            </div>
        </div>

    </div>

    <!-- Middle: visualizer + KPI strip -->
    <div class="col-lg-6 col-md-8 col-sm-12">
        <div class="panel panel-default">
            <div class="panel-heading sf-panel-heading-inline sf-panel-heading-center">
                <div class="sf-heading-left">
                    <span>Visualizer</span>
                    <span class="sf-help" data-toggle="tooltip" data-placement="left" title="Switch between 2D outline and 3D mannequin views of the shrinkage result.">
                        ?
                    </span>
                </div>
                <div class="btn-group btn-group-xs" role="group" aria-label="Visualizer mode">
                    <button type="button" class="btn btn-default" id="viewMode2d" data-mode="2d">2D</button>
                    <button type="button" class="btn btn-default" id="viewMode3d" data-mode="3d">3D</button>
                </div>
            </div>
            <div class="panel-body">
                <div class="sf-canvas-wrap sf-visualizer-wrap">
                    <canvas id="sweaterCanvas" width="520" height="480"></canvas>
                </div>
                <div class="sf-legend" aria-label="Shrinkage legend">
                    <div class="sf-legend-item">
                        <span class="sf-legend-badge">L</span>
                        <div>
                            <div class="sf-legend-label">Length</div>
                            <div class="sf-legend-value" id="legendLength">--</div>
                        </div>
                    </div>
                    <div class="sf-legend-item">
                        <span class="sf-legend-badge">W</span>
                        <div>
                            <div class="sf-legend-label">Width</div>
                            <div class="sf-legend-value" id="legendWidth">--</div>
                        </div>
                    </div>
                    <div class="sf-legend-item">
                        <span class="sf-legend-badge">S</span>
                        <div>
                            <div class="sf-legend-label">Sleeve</div>
                            <div class="sf-legend-value" id="legendSleeve">--</div>
                        </div>
                    </div>
                </div>
                <div class="sf-canvas-wrap">
                    <canvas id="mannequinCanvas" width="520" height="480" style="display:none;" data-models-root="@Url.Content("~/models/")"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-12 col-sm-12">
        <div class="sf-section">
        <div class="sf-section-title">
            Insights
        </div>
            <div class="panel panel-default sf-panel-compact sf-insights-panel">
                <div class="panel-body sf-insights-body">
                    <div class="sf-tabs-group">
                        <div class="sf-tab-group-title">
                            Curve
                            <span class="sf-help" data-toggle="tooltip" data-placement="right" title="Shows how length factor changes over temperature for the current dwell time.">
                                ?
                            </span>
                        </div>
                        <p class="sf-tab-desc">Length factor over temperature for the selected dwell time.</p>
                        <div class="sf-canvas-wrap">
                            <canvas id="shrinkageChart" width="320" height="260"></canvas>
                        </div>
                    </div>

                    <div class="sf-tabs-group" style="margin-top:12px;">
                        <div class="sf-tab-group-title">
                            Surface
                            <span class="sf-help" data-toggle="tooltip" data-placement="right" title="Contour map of shrinkage across temperature and dwell time for the selected factor.">
                                ?
                            </span>
                        </div>
                        <p class="sf-tab-desc">Contour map of shrinkage across temperature and dwell time.</p>
                        <div class="form-group">
                            <label>Factor</label>
                            <select id="surfaceFactor" class="form-control">
                                <option value="length" selected>Length</option>
                                <option value="width">Width</option>
                                <option value="sleeve">Sleeve</option>
                            </select>
                        </div>
                        <div class="sf-canvas-wrap sf-surface-wrap">
                            <canvas id="surfaceCanvas" width="360" height="260" style="border:1px solid #eee;"></canvas>
                        </div>
                    </div>

                    <div class="sf-insights-spacer"></div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="sf-tooling">
    <div class="sf-section-title">
        Smart factory
    </div>
    <div class="panel panel-default sf-panel-compact">
        <div class="panel-body">
            <p class="sf-tab-desc sf-info-note sf-info-compact">Goal: pick feasible heat-setting parameters that balance quality and throughput.</p>
            <div class="row sf-tooling-row">
                <div class="col-lg-4 col-md-6">
                    <div class="panel panel-default sf-panel-compact">
                    <div class="panel-heading">
                        Quality & Optimization (Length)
                        <span class="sf-help" data-toggle="tooltip" data-placement="left" title="Set a target length factor and check if the current setting meets it.">
                            ?
                        </span>
                    </div>
                        <div class="panel-body">
                            <div class="form-group">
                                <label>Length factor target</label>
                                <input type="number" id="lengthTarget" class="form-control" value="0.92" step="0.01" min="0.80" max="1.10" />
                                <p class="sf-range-hint">Example: 0.92 means 8% shrink in length.</p>
                            </div>
                            <div id="constraintStatus" class="sf-status-note">Target not evaluated yet.</div>
                            <div id="explainPanel" class="sf-info-note sf-info-compact">Interpolation: <span id="interpMode">-</span></div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="panel panel-default sf-panel-compact">
                    <div class="panel-heading">
                        Presets & Optimization
                        <span class="sf-help" data-toggle="tooltip" data-placement="left" title="Quick presets for common operating points and a search for the best match.">
                            ?
                        </span>
                    </div>
                        <div class="panel-body">
                            <p class="sf-tab-desc">Pick a preset for common operating points, then optimize around the length target.</p>
                            <div class="form-group">
                                <label>Preset</label>
                                <div class="input-group">
                                    <select id="presetSelect" class="form-control">
                                        <option value="low">Low energy</option>
                                        <option value="balanced" selected>Balanced</option>
                                        <option value="max">Max shrink</option>
                                        <option value="safe">Safe</option>
                                    </select>
                                    <span class="input-group-btn">
                                        <button type="button" class="btn btn-default" id="presetApply">Apply</button>
                                    </span>
                                </div>
                            </div>
                            <div>
                                <button type="button" class="btn btn-primary" id="btnOptimize">Find best settings</button>
                                <span id="optStatus" class="text-muted" style="margin-left:10px;"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-12">
                    <div class="panel panel-default sf-panel-compact">
                    <div class="panel-heading">
                        Recommendations
                        <span class="sf-help" data-toggle="tooltip" data-placement="left" title="Generate feasible settings ranked by throughput, energy, or target accuracy.">
                            ?
                        </span>
                    </div>
                        <div class="panel-body">
                            <div class="form-group">
                                <label>Mode</label>
                                <select id="recMode" class="form-control">
                                    <option value="throughput" selected>Max throughput (min dwell)</option>
                                    <option value="energy">Min energy/stress (min temperature)</option>
                                    <option value="target">Hit target shrinkage factors</option>
                                </select>
                            </div>

                            <p class="sf-tab-desc">Recommendations are ranked by the selected mode, while respecting the minimum factors below.</p>

                            <div class="row">
                                <div class="col-xs-4">
                                    <div class="form-group">
                                        <label>Min L</label>
                                        <input type="number" id="recMinLength" class="form-control" value="0.90" step="0.01" min="0.80" max="1.10" />
                                    </div>
                                </div>
                                <div class="col-xs-4">
                                    <div class="form-group">
                                        <label>Min W</label>
                                        <input type="number" id="recMinWidth" class="form-control" value="0.90" step="0.01" min="0.80" max="1.10" />
                                    </div>
                                </div>
                                <div class="col-xs-4">
                                    <div class="form-group">
                                        <label>Min S</label>
                                        <input type="number" id="recMinSleeve" class="form-control" value="0.90" step="0.01" min="0.80" max="1.10" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label>Max Temp (&deg;C)</label>
                                        <input type="number" id="recMaxTemp" class="form-control" placeholder="(optional)" min="30" max="200" step="1" />
                                    </div>
                                </div>
                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label>Max Dwell (min)</label>
                                        <input type="number" id="recMaxDwell" class="form-control" placeholder="(optional)" min="1" max="20" step="0.5" />
                                    </div>
                                </div>
                            </div>

                            <div id="recTargets" style="display:none;">
                                <div class="row">
                                    <div class="col-xs-4">
                                        <div class="form-group">
                                            <label>Target L</label>
                                            <input type="number" id="recTargetLength" class="form-control" value="0.95" step="0.01" min="0.80" max="1.10" />
                                        </div>
                                    </div>
                                    <div class="col-xs-4">
                                        <div class="form-group">
                                            <label>Target W</label>
                                            <input type="number" id="recTargetWidth" class="form-control" value="0.95" step="0.01" min="0.80" max="1.10" />
                                        </div>
                                    </div>
                                    <div class="col-xs-4">
                                        <div class="form-group">
                                            <label>Target S</label>
                                            <input type="number" id="recTargetSleeve" class="form-control" value="0.95" step="0.01" min="0.80" max="1.10" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="recResults" style="margin-top:12px; display:none;">
                                <div class="sf-section-title" style="margin-top:0;">Top candidates</div>
                                <div class="table-responsive">
                                    <table class="table table-condensed" style="margin-bottom:0;">
                                        <thead>
                                            <tr>
                                                <th>Label</th>
                                                <th>T</th>
                                                <th>D</th>
                                                <th>L</th>
                                                <th>W</th>
                                                <th>S</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody id="recTable"></tbody>
                                    </table>
                                </div>
                            </div>
                            <div style="margin-top:12px;">
                                <button type="button" class="btn btn-success" id="btnRecommend" style="margin-right:8px;">Recommend settings</button>
                                <span id="recStatus" class="text-muted"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.4.0/Chart.min.js"></script>
    <script src="~/lib/babylon/babylon.2.2.max.js"></script>
    <script src="~/lib/babylon/babylon.glTFFileLoader.js"></script>
    <script src="~/js/simulator.js"></script>
    <script src="~/js/sweater-renderer.js"></script>
    <script src="~/js/mannequin-viewer.js"></script>
}
