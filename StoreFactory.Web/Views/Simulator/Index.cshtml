@model StoreFactory.Web.Models.SimulatorViewModel

@{
    ViewData["Title"] = "Simulator";
}

<div class="page-header" style="margin-top:0">
    <h2 style="margin-top:0">Simulator <small>heat setting and shrinkage</small></h2>
</div>

<div class="row">
    <!-- Left: Process settings -->
    <div class="col-lg-3 col-md-4 col-sm-12">
        <div class="sf-section">
            <div class="sf-section-title">Inputs</div>
            <div class="panel panel-default sf-panel-compact">
                <div class="panel-body">
                    <form id="simulatorForm">
                        <div class="form-group">
                            <label>Material</label>
                            <select asp-for="SelectedMaterialId" asp-items="Model.Materials" class="form-control"></select>
                        </div>

                        <div class="form-group">
                            <label>Temperature <span class="sf-unit">&deg;C</span></label>
                            <div class="sf-range-row">
                                <input asp-for="Temperature" type="range" min="30" max="200" step="1" class="form-control" />
                                <span id="tempValue" class="sf-range-value">@Model.Temperature</span>
                            </div>
                            <div class="sf-range-hint">Range 30&ndash;200 &deg;C</div>
                        </div>

                        <div class="form-group">
                            <label>Dwell Time <span class="sf-unit">m/min</span></label>
                            <div class="sf-range-row">
                                <input asp-for="DwellTime" type="range" min="1" max="20" step="0.5" class="form-control" />
                                <span id="timeValue" class="sf-range-value">@Model.DwellTime</span>
                            </div>
                            <div class="sf-range-hint">Range 1&ndash;20 m/min</div>
                        </div>
                    </form>

                    <div class="help-block" style="margin-bottom:0">
                        Tip: <strong>1.00</strong> = no change, <strong>&lt; 1</strong> shrink, <strong>&gt; 1</strong> expand.
                    </div>
                </div>
            </div>
        </div>

        <div class="sf-section">
            <div class="sf-section-title">Smart factory</div>
            <div class="panel panel-default sf-panel-compact">
                <div class="panel-body">
                    <p class="sf-tab-desc" style="margin-bottom:10px;">Goal: pick feasible heat-setting parameters for quality and throughput.</p>
                    <button type="button" class="btn btn-success" id="btnRecommend" style="margin-right:8px;">Recommend settings</button>
                    <span id="recStatus" class="text-muted"></span>
                </div>
            </div>
        </div>

        <div class="sf-section">
            <div class="sf-section-title">Results</div>
            <div class="panel panel-info sf-panel-compact">
                <div class="panel-body" id="resultsPanel">
                    <div class="sf-result-row">
                        <div>
                            <div class="sf-result-label">Length factor</div>
                            <div class="sf-result-caption">Main shrinkage indicator</div>
                        </div>
                        <div id="resLength" class="sf-result-value text-success">-</div>
                    </div>
                    <div class="sf-result-row">
                        <div>
                            <div class="sf-result-label">Width factor</div>
                            <div class="sf-result-caption">Cross direction change</div>
                        </div>
                        <div id="resWidth" class="sf-result-value text-success">-</div>
                    </div>
                    <div class="sf-result-row">
                        <div>
                            <div class="sf-result-label">Sleeve factor</div>
                            <div class="sf-result-caption">Sleeve dimension change</div>
                        </div>
                        <div id="resSleeve" class="sf-result-value text-success">-</div>
                    </div>

                    <div class="sf-result-row">
                        <div>
                            <div class="sf-result-label">Confidence</div>
                            <div class="sf-result-caption">Based on distance to measured data points</div>
                        </div>
                        <div id="resConfidence" class="sf-result-value">-</div>
                    </div>
                    <!-- warningMsg and loadingOverlay are injected here by simulator.js -->
                </div>
            </div>
        </div>

    </div>

    <!-- Middle: visualizer + KPI strip -->
    <div class="col-lg-6 col-md-8 col-sm-12">
        <div class="sf-kpi-strip" role="status" aria-label="Current KPIs">
            <div class="sf-kpi">
                <div class="sf-kpi-label">Length</div>
                <div class="sf-kpi-value" id="kpiLength">-</div>
            </div>
            <div class="sf-kpi">
                <div class="sf-kpi-label">Width</div>
                <div class="sf-kpi-value" id="kpiWidth">-</div>
            </div>
            <div class="sf-kpi">
                <div class="sf-kpi-label">Sleeve</div>
                <div class="sf-kpi-value" id="kpiSleeve">-</div>
            </div>
            <div class="sf-kpi">
                <div class="sf-kpi-label">Confidence</div>
                <div class="sf-kpi-value" id="kpiConfidence">-</div>
            </div>
            <div class="sf-kpi sf-kpi-wide">
                <div class="sf-kpi-label">Status</div>
                <div class="sf-kpi-value" id="kpiStatus">-</div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                Visualizer
                <div class="btn-group btn-group-xs pull-right" role="group" aria-label="Visualizer mode">
                    <button type="button" class="btn btn-default" id="viewMode2d" data-mode="2d">2D</button>
                    <button type="button" class="btn btn-default" id="viewMode3d" data-mode="3d">3D</button>
                </div>
            </div>
            <div class="panel-body">
                <div class="sf-canvas-wrap">
                    <canvas id="sweaterCanvas" width="520" height="480" style="border:1px solid #eee;"></canvas>
                </div>
                <div class="sf-canvas-wrap">
                    <canvas id="mannequinCanvas" width="520" height="480" style="border:1px solid #eee; display:none;" data-models-root="@Url.Content("~/models/")"></canvas>
                </div>
                <div id="mannequinDebugPanel" class="well well-sm" style="margin-top:12px; display:none;">
                    <div class="sf-section-title" style="margin-top:0;">3D Debug Controls</div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Torso offset X</label>
                                <input type="range" id="dbgTorsoX" min="-50" max="50" step="0.01" value="0" class="form-control" />
                                <span id="dbgTorsoXVal" class="help-block">0.00</span>
                            </div>
                            <div class="form-group">
                                <label>Torso offset Y</label>
                                <input type="range" id="dbgTorsoY" min="-50" max="50" step="0.01" value="0" class="form-control" />
                                <span id="dbgTorsoYVal" class="help-block">0.00</span>
                            </div>
                            <div class="form-group">
                                <label>Torso offset Z</label>
                                <input type="range" id="dbgTorsoZ" min="-50" max="50" step="0.01" value="0" class="form-control" />
                                <span id="dbgTorsoZVal" class="help-block">0.00</span>
                            </div>
                            <div class="form-group">
                                <label>Torso scale</label>
                                <input type="range" id="dbgTorsoScale" min="0.01" max="20" step="0.01" value="1" class="form-control" />
                                <span id="dbgTorsoScaleVal" class="help-block">1.00</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>T-shirt offset X</label>
                                <input type="range" id="dbgShirtX" min="-10" max="10" step="0.01" value="0" class="form-control" />
                                <span id="dbgShirtXVal" class="help-block">0.00</span>
                            </div>
                            <div class="form-group">
                                <label>T-shirt offset Y</label>
                                <input type="range" id="dbgShirtY" min="-10" max="10" step="0.01" value="0" class="form-control" />
                                <span id="dbgShirtYVal" class="help-block">0.00</span>
                            </div>
                            <div class="form-group">
                                <label>T-shirt offset Z</label>
                                <input type="range" id="dbgShirtZ" min="-10" max="10" step="0.01" value="0" class="form-control" />
                                <span id="dbgShirtZVal" class="help-block">0.00</span>
                            </div>
                            <div class="form-group">
                                <label>T-shirt scale</label>
                                <input type="range" id="dbgShirtScale" min="0.01" max="5" step="0.01" value="1" class="form-control" />
                                <span id="dbgShirtScaleVal" class="help-block">1.00</span>
                            </div>
                        </div>
                    </div>
                    <hr style="margin:10px 0;" />
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Camera alpha</label>
                                <input type="range" id="dbgCamAlpha" min="0" max="12.56" step="0.01" value="1.57" class="form-control" />
                                <span id="dbgCamAlphaVal" class="help-block">1.57</span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Camera beta</label>
                                <input type="range" id="dbgCamBeta" min="0.01" max="6.27" step="0.01" value="1.57" class="form-control" />
                                <span id="dbgCamBetaVal" class="help-block">1.57</span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Camera radius</label>
                                <input type="range" id="dbgCamRadius" min="0.5" max="500" step="0.1" value="4" class="form-control" />
                                <span id="dbgCamRadiusVal" class="help-block">4.0</span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Camera target X</label>
                                <input type="range" id="dbgCamTargetX" min="-20" max="20" step="0.01" value="0" class="form-control" />
                                <span id="dbgCamTargetXVal" class="help-block">0.00</span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Camera target Y</label>
                                <input type="range" id="dbgCamTargetY" min="-20" max="20" step="0.01" value="0" class="form-control" />
                                <span id="dbgCamTargetYVal" class="help-block">0.00</span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Camera target Z</label>
                                <input type="range" id="dbgCamTargetZ" min="-20" max="20" step="0.01" value="0" class="form-control" />
                                <span id="dbgCamTargetZVal" class="help-block">0.00</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label>Debug output (copy/paste)</label>
                        <textarea id="dbgOutput" class="form-control" rows="4" readonly></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Smart Factory decision support -->
    <div class="col-lg-3 col-md-12 col-sm-12">
        <div class="sf-section">
            <div class="sf-section-title">Smart factory</div>
            <div class="panel panel-default sf-panel-compact sf-panel-insight">
                <div class="panel-body">
                    <ul class="nav nav-pills nav-justified sf-insights-tabs" role="tablist">
                        <li role="presentation" class="active"><a href="#sfTabRecommend" aria-controls="sfTabRecommend" role="tab" data-toggle="tab">Recommendation</a></li>
                        <li role="presentation"><a href="#sfTabInsights" aria-controls="sfTabInsights" role="tab" data-toggle="tab">Insights</a></li>
                        <li role="presentation"><a href="#sfTabConstraints" aria-controls="sfTabConstraints" role="tab" data-toggle="tab">Constraints</a></li>
                    </ul>

                    <div class="tab-content" style="margin-top:12px;">
                        <div role="tabpanel" class="tab-pane active" id="sfTabRecommend">
                            <div class="form-group">
                                <label>Mode</label>
                                <select id="recMode" class="form-control">
                                    <option value="throughput" selected>Max throughput (min dwell)</option>
                                    <option value="energy">Min energy / stress (min temperature)</option>
                                    <option value="target">Hit target factors</option>
                                </select>
                            </div>

                            <div class="row">
                                <div class="col-xs-4">
                                    <div class="form-group">
                                        <label>Min L</label>
                                        <input type="number" id="recMinLength" class="form-control" value="0.90" step="0.01" min="0.80" max="1.10" />
                                    </div>
                                </div>
                                <div class="col-xs-4">
                                    <div class="form-group">
                                        <label>Min W</label>
                                        <input type="number" id="recMinWidth" class="form-control" value="0.90" step="0.01" min="0.80" max="1.10" />
                                    </div>
                                </div>
                                <div class="col-xs-4">
                                    <div class="form-group">
                                        <label>Min S</label>
                                        <input type="number" id="recMinSleeve" class="form-control" value="0.90" step="0.01" min="0.80" max="1.10" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label>Max Temp (&deg;C)</label>
                                        <input type="number" id="recMaxTemp" class="form-control" placeholder="(optional)" min="30" max="200" step="1" />
                                    </div>
                                </div>
                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label>Max Dwell (m/min)</label>
                                        <input type="number" id="recMaxDwell" class="form-control" placeholder="(optional)" min="1" max="20" step="0.5" />
                                    </div>
                                </div>
                            </div>

                            <div id="recTargets" style="display:none;">
                                <div class="row">
                                    <div class="col-xs-4">
                                        <div class="form-group">
                                            <label>Target L</label>
                                            <input type="number" id="recTargetLength" class="form-control" value="0.95" step="0.01" min="0.80" max="1.10" />
                                        </div>
                                    </div>
                                    <div class="col-xs-4">
                                        <div class="form-group">
                                            <label>Target W</label>
                                            <input type="number" id="recTargetWidth" class="form-control" value="0.95" step="0.01" min="0.80" max="1.10" />
                                        </div>
                                    </div>
                                    <div class="col-xs-4">
                                        <div class="form-group">
                                            <label>Target S</label>
                                            <input type="number" id="recTargetSleeve" class="form-control" value="0.95" step="0.01" min="0.80" max="1.10" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="recResults" style="margin-top:12px; display:none;">
                                <div class="sf-section-title" style="margin-top:0;">Top candidates</div>
                                <div class="table-responsive">
                                    <table class="table table-condensed" style="margin-bottom:0;">
                                        <thead>
                                            <tr>
                                                <th>Label</th>
                                                <th>T</th>
                                                <th>D</th>
                                                <th>L</th>
                                                <th>W</th>
                                                <th>S</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody id="recTable"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div role="tabpanel" class="tab-pane" id="sfTabInsights">
                            <p class="sf-tab-desc">Use these plots to explain and validate the recommendation.</p>
                            <div class="sf-tabs-group">
                                <div class="sf-tab-group-title">Curve</div>
                                <div class="sf-canvas-wrap">
                                    <canvas id="shrinkageChart" width="320" height="200"></canvas>
                                </div>
                            </div>

                            <div class="sf-tabs-group" style="margin-top:12px;">
                                <div class="sf-tab-group-title">Surface</div>
                                <div class="form-group">
                                    <label>Factor</label>
                                    <select id="surfaceFactor" class="form-control">
                                        <option value="length" selected>Length</option>
                                        <option value="width">Width</option>
                                        <option value="sleeve">Sleeve</option>
                                    </select>
                                </div>
                                <div class="sf-canvas-wrap">
                                    <canvas id="surfaceCanvas" width="320" height="220" style="border:1px solid #eee;"></canvas>
                                </div>
                            </div>
                        </div>

                        <div role="tabpanel" class="tab-pane" id="sfTabConstraints">
                            <p class="sf-tab-desc">Define feasible bounds for quality.
                            </p>
                            <div class="form-group">
                                <label>Min acceptable Length Factor</label>
                                <input type="number" id="minLength" class="form-control" value="0.90" step="0.01" min="0.80" max="1.10" />
                            </div>
                            <div id="constraintStatus" class="alert alert-info" style="margin-top:10px;">Constraints not evaluated yet.</div>
                            <div id="explainPanel" class="well well-sm" style="margin-top:10px;">Interpolation: <span id="interpMode">-</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="sf-tooling">
    <div class="sf-section-title">Operations</div>
    <div class="row">
        <div class="col-lg-4 col-md-6">
            <div class="panel panel-default sf-panel-compact">
                <div class="panel-heading">Presets & optimization</div>
                <div class="panel-body">
                    <p class="sf-tab-desc">Pick a preset or search for a target shrinkage factor.</p>
                    <div class="btn-group" role="group" aria-label="Presets" style="margin-bottom:10px;">
                        <button type="button" class="btn btn-default" id="presetLow">Low energy</button>
                        <button type="button" class="btn btn-default" id="presetBalanced">Balanced</button>
                        <button type="button" class="btn btn-default" id="presetMax">Max shrink</button>
                        <button type="button" class="btn btn-default" id="presetSafe">Safe</button>
                    </div>

                    <div class="form-group">
                        <label>Target factor (Length)</label>
                        <input type="number" id="targetFactor" class="form-control" value="0.92" step="0.01" min="0.80" max="1.10" />
                    </div>
                    <button type="button" class="btn btn-primary" id="btnOptimize">Find settings</button>
                    <span id="optStatus" class="text-muted" style="margin-left:10px;"></span>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="panel panel-default sf-panel-compact">
                <div class="panel-heading">Experiment log</div>
                <div class="panel-body">
                    <p class="sf-tab-desc">Capture current runs and export the last results.</p>
                    <div class="form-group">
                        <label>Note</label>
                        <input type="text" id="expNote" class="form-control" placeholder="optional note" />
                    </div>
                    <button type="button" class="btn btn-default" id="btnLog">Log current run</button>
                    <button type="button" class="btn btn-default" id="btnExportCsv">Export CSV</button>

                    <div class="table-responsive" style="margin-top:10px;">
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Mat</th>
                                    <th>T</th>
                                    <th>D</th>
                                    <th>L</th>
                                    <th>W</th>
                                    <th>S</th>
                                </tr>
                            </thead>
                            <tbody id="expTable"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.4.0/Chart.min.js"></script>
    <script src="~/lib/babylon/babylon.2.2.max.js"></script>
    <script src="~/lib/babylon/babylon.glTFFileLoader.js"></script>
    <script src="~/js/simulator.js"></script>
    <script src="~/js/sweater-renderer.js"></script>
    <script src="~/js/mannequin-viewer.js"></script>
}
